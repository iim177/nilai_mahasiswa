# =========================================================
# KONFIGURASI DATABASE
# =========================================================
# --- Kalau dijalankan LOKAL (laptop, pakai Laragon) ---
# Default Laragon: user "root", password kosong, port 3306
#   DB_HOST=127.0.0.1
#
# --- Kalau dijalankan di DALAM DOCKER, connect ke MySQL yang ada
#     LANGSUNG di VPS (bukan di container lain) ---
#   DB_HOST=host.docker.internal
#   (127.0.0.1 TIDAK BISA dipakai di sini, karena di dalam container itu
#    berarti "container itu sendiri", bukan VPS-nya. Lihat DEPLOYMENT.md)

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nilai_mahasiswa

# =========================================================
# SECRET KEY - buat session login (isi bebas, string acak)
# =========================================================
SECRET_KEY=ganti-dengan-string-acak-yang-panjang-dan-rahasia
